# Local development — copy to backend/.env and fill in real values
#
# DATABASE_URL  → Your PostgreSQL connection string.
#                 Aiven, Neon, Supabase, Render Postgres, or local Docker.
#
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@pg-xxx.aivencloud.com:PORT/defaultdb?sslmode=require

# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=change-me-to-at-least-32-random-chars

# Admin dashboard password
ADMIN_PASSWORD=change-me

# CORS: use * for local dev; set exact frontend origin in production
# e.g. CORS_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app
CORS_ORIGINS=*
